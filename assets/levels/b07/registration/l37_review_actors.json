    "geometry": "Read-only body presentation. Hit origins, warnings, timing, navigation and collision are unchanged.",
    "world_ground_offset": {
      "review_value": [
        0,
        0
      ],
      "legacy_value_preserved": [
        0,
        18
      ],
      "reason": "EnemyActor position is the navigation/collision command root; EnemyActor._draw draws its ground shadow at Vector2.ZERO. The L37 review maps the authored two-foot midpoint (or explicit airborne projected floor) to that same local zero rather than retaining the legacy 18px body offset. This is a translation of presentation only, not a change of scale, collider, command or sort position. Only b07_review_bank selects zero; old art-trial and other chapters retain their existing offset.",
      "evidence": [
        "scripts/gameplay/monsters/enemy_actor.gd:_draw",
        "scripts/presentation/monsters/enemy_art.gd:install",
        "scripts/presentation/monsters/enemy_visual.gd:body_frame"
      ]
    }
  },
