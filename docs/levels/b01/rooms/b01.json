{
  "biome_id": "B01",
  "name": "晴辉遗庭",
  "race": "魔法构装族",
  "palette": {"ground": "#F4E3B5", "accent": "#BC863F", "secondary": "#58C3CF", "foliage": "#78AA58"},
  "story": "晴辉园匠曾让太阳、泉水与机械花共同照料这座庭园。校准中断后，构装守卫继续执行封园命令；玩家循着六处失衡的园艺机关，抵达日曜机关巨像守护的核心庭院。",
  "edge_design": {
    "north": "远处米白庭廊、透明晶芽温室和铜枝风铃，梁架透空，阳光与叶影自然连到内场。",
    "east": "白石边缘接细长浅青水渠、睡莲和铜金导水嘴；对岸是清绿花架，不铺灰色空白。",
    "south": "低矮藤蔓栏、下层花园与一段通向庭外的白石阶梯，表现真实露台厚度；前景少量花叶。",
    "west": "连续白石路接园匠花圃、曲背椅和短柱，局部打开入口，背景铜叶拱门与晶花轮廓。",
    "transition": "内场浅色石砖先经过零散草缝、窄花边或完整的收边石，再接较低的窄水渠和下一层庭园；厚度来自单独绘制的短石侧面，禁止拉伸地板贴图作高墙。",
    "foreground": "只在最下方两个角放少量柔焦藤叶和小花，叶片逐步淡化；不遮入口、角色、任务机关或攻击预警。"
  },
  "asset_families": [
    {"key": "sun_clock", "name": "日轮花钟", "visual": "低矮米白圆石盘，黄铜花瓣指针与青蓝晶核；钟面嵌入地面，花瓣边缘投短影，不是立墙。"},
    {"key": "ivy_column", "name": "藤冠短柱", "visual": "断面圆润的米白短柱，青绿藤冠和铜叶铭牌，低于角色肩部。"},
    {"key": "canal_edge", "name": "外围细水渠", "visual": "边界外的狭长浅青流水，白石矮岸与睡莲，只沿地图外围出现。"},
    {"key": "clockwork_flower", "name": "齿瓣机械花", "visual": "黄铜弯茎托起白陶花瓣，中心是青蓝玻璃珠，细叶像小齿轮。"},
    {"key": "sun_lantern", "name": "光籽灯", "visual": "铜枝托着暖黄色发光种子，矮底座和星形透光孔，白天也能认出轮廓。"},
    {"key": "crystal_lens", "name": "晶透镜架", "visual": "细黄铜三脚支架和透蓝椭圆镜片，镜内可见微小太阳光纹。"},
    {"key": "bronze_bench", "name": "园匠曲背椅", "visual": "小巧铜制曲背椅，米白坐面和叶脉靠背，保持低轮廓。"},
    {"key": "prism_arch", "name": "浮晶光拱", "visual": "三枚悬浮棱晶围成透空拱形，细白石双足，虹光只出现在边缘。"},
    {"key": "glass_greenhouse", "name": "晶芽小温室", "visual": "半球玻璃小温室，黄铜细框，里面是会发光的嫩芽和陶盆。"},
    {"key": "runic_disk", "name": "符文齿盘", "visual": "与地面齐平的三层圆形机关纹，青蓝细线、铜金齿缘，没有高台或坑洞。"},
    {"key": "orrery", "name": "小日月星仪", "visual": "铜金轨道围绕日曜球，青蓝月晶悬在环上；下部通透，只投短影。"},
    {"key": "copper_furnace", "name": "吐云铜炉", "visual": "圆肚小炉与花瓣烟口，烟像两朵小棉云，暖黄炉心不产生遮挡浓烟。"},
    {"key": "weighing_fan", "name": "三叶光秤", "visual": "三片白陶托叶绕着铜轴，分别镶圆、三角、菱形晶片，像园艺风车。"},
    {"key": "lift_pod", "name": "花蕾升降舱", "visual": "荷花形低矮白陶舱，铜金支脚与青蓝弹簧，下缘圆润，没有高墙侧面。"},
    {"key": "crystal_valve", "name": "晶露阀", "visual": "黄铜手轮与透明水滴晶体，短管贴地铺设，和旧式绞盘轮廓不同。"},
    {"key": "sun_altar", "name": "日曜校准座", "visual": "低矮八瓣白石校准座，三条青蓝能源细纹连到铜金太阳核心。"},
    {"key": "bell_tree", "name": "铜铃树", "visual": "弯曲铜枝挂白陶小铃，顶部嫩叶与晶铃错落，树冠通透。"},
    {"key": "seed_cradle", "name": "晶籽摇篮", "visual": "叶片形小托架与玻璃晶籽，微小机械蜗牛躲在托架下，富有园艺生活感。"},
    {"key": "cloud_sculpture", "name": "云绵石雕", "visual": "米白石材雕成胖云雀，铜喙衔青蓝晶叶，矮圆座。"},
    {"key": "coolant_amphora", "name": "冷露陶瓶", "visual": "白陶双耳瓶配铜金封口，浅青凝露沿瓶壁泛光，底部完整圆润。"}
  ],
